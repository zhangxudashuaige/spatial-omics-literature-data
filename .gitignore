# Downloaded datasets and local-only article files
data/**
!data/.gitkeep
papers/**/attachments/**
!papers/**/attachments/.gitkeep

# Generated checksums and temporary files
*.tmp
*.part
__pycache__/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.venv/
.xie_manifest_work/
papers/**/metadata/*.local.json
papers/**/*.h5ad
!papers/**/sample_data/sample_*_cells.h5ad

# Foundation-model dataset modules: keep manifests/scripts, not large payloads
datasets/**/raw/**
datasets/**/processed/**
datasets/**/save_model/**
datasets/**/save_results/**
datasets/**/*.zip
datasets/**/*.tar
datasets/**/*.tar.gz
datasets/**/*.fastq
datasets/**/*.fastq.gz
datasets/**/*.fq.gz
datasets/**/*.bam
datasets/**/*.sam
datasets/**/*.h5
datasets/**/*.h5ad
datasets/**/*.loom
datasets/**/*.rds
datasets/**/*.pt
datasets/**/*.pth
datasets/**/*.ckpt
datasets/**/*.npy
datasets/**/*.npz
datasets/**/*.mtx.gz
datasets/**/*.csv.gz
datasets/**/*.tif
datasets/**/*.tiff
datasets/**/*.gef
datasets/**/*.gem
datasets/**/checksums.local.*
datasets/**/inspection.local.*
