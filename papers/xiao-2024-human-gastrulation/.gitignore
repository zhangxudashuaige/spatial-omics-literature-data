!data/processed/.gitkeep
!data/external/.gitkeep

*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.sam
*.h5ad
*.h5
*.hdf5
*.gef
*.gem
*.loom
*.rds
*.RDS
*.tif
*.tiff
*.tar
*.tar.gz
*.zip
*.part

# 大型表格只放 data/，metadata/ 中的小型清单允许跟踪
data/**/*.csv
data/**/*.tsv
data/**/*.csv.gz
data/**/*.tsv.gz

.ipynb_checkpoints/
__pycache__/
*.pyc
