*.tgz
*.7z

# 患者级原始数据
data/raw/patient_level/**

# 元数据中的大型文件
data/metadata/*.local.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# 虚拟环境
venv/
.venv/
env/

